<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             
             
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             
             xmlns:vm="using:demka1.ViewModels"
             x:DataType="vm:MainViewModel"

             x:Class="demka1.Page1">

  <Grid RowDefinitions="Auto, Auto, *"> 
         <!-- Верхняя панель: заголовок + ФИО пользователя -->
        <Border Grid.Row="0" Background="#DDD" Padding="10">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <TextBlock Grid.Column="0"
                           Text="{Binding PageTitle}"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="15">
                    <TextBlock Text="{Binding CurrentUser.FullName}"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                    <Button Content="Выйти" Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель с кнопкой "Назад" -->
        <Border Grid.Row="1" Padding="10">
            <Button Content="← Назад" Command="{Binding BackCommand}"/>
        </Border>

  <ScrollViewer Grid.Row="2"
       VerticalScrollBarVisibility="Visible"
        HorizontalScrollBarVisibility="Disabled">

 
  <ItemsControl ItemsSource="{Binding Products}">
      <ItemsControl.ItemTemplate>
          <DataTemplate>
           
                    <Border BorderBrush="Black" BorderThickness="1" Margin="10" Padding="10"
                             Background="{Binding CardBackground}">
                        <Grid ColumnDefinitions="150, *, Auto">

                            
                            <Image Grid.Column="0"
                                   Source="{Binding ProductImage}"
                                   Width="120" Height="80"
                                   Stretch="Uniform"
                                   Margin="0,0,10,0"/>

                            <!-- текстовая информация -->
                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center">
                                    <Run Text="{Binding IdManufactureNavigation.Title}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding Title}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Категория: "/>
                                    <Run Text="{Binding IdCategoryNavigation.Title}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Количество: "/>
                                    <Run Text="{Binding CountString}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Состав: "/>
                                    <Run Text="{Binding Structure}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- цена -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="100">
                                <StackPanel IsVisible="{Binding HasDiscount}">
                                    <TextBlock Text="{Binding FinalPrice, StringFormat='{}{0} руб.'}"
                                               FontSize="20" Foreground="Red" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding Price, StringFormat='{}{0} руб.'}"
                                               FontSize="14" TextDecorations="Strikethrough"
                                               Foreground="Gray" HorizontalAlignment="Right"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Price, StringFormat='{}{0} руб.'}"
                                           FontSize="20"
                                           IsVisible="{Binding !HasDiscount}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

          </DataTemplate>
      </ItemsControl.ItemTemplate>
 </ItemsControl>
  
  </ScrollViewer> 
 
    </Grid>
</UserControl>
