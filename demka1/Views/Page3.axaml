<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

             xmlns:vm="using:demka1.ViewModels"
             x:DataType="vm:MainViewModel"



             xmlns:models="using:demka1.Models"  

             x:Class="demka1.Page3">
 <Grid RowDefinitions="Auto, *">

        <!-- заголовок -->
        <Border Grid.Row="0" Background="#DDD" Padding="10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Text="{Binding PageTitle}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding CurrentUser.FullName}" FontSize="16" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- основное содержимое: слева товар, справа заказ -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 400">

            <!--  инфоомация о товаре -->
            <ScrollViewer Grid.Column="0">
                <StackPanel Margin="15" Spacing="10">

                    <Image Source="{Binding SelectedProduct.ProductImage}"
                           Width="300" Height="200" Stretch="Uniform"
                           HorizontalAlignment="Left"/>

                    <TextBlock FontSize="22" FontWeight="Bold">
                        <Run Text="{Binding SelectedProduct.IdManufactureNavigation.Title}"/>
                        <Run Text=" | "/>
                        <Run Text="{Binding SelectedProduct.Title}"/>
                    </TextBlock>

                    <TextBlock>
                        <Run Text="Категория: "/>
                        <Run Text="{Binding SelectedProduct.IdCategoryNavigation.Title}"/>
                    </TextBlock>

                    <TextBlock>
                        <Run Text="Состав: "/>
                        <Run Text="{Binding SelectedProduct.Structure}"/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Описание: "/>
                        <Run Text="{Binding SelectedProduct.Description}"/>
                    </TextBlock>

                    <TextBlock FontSize="18" Foreground="Red">
                        <Run Text="Цена со скидкой: "/>
                        <Run Text="{Binding SelectedProduct.FinalPrice, StringFormat='{}{0} руб.'}"/>
                    </TextBlock>

                    <!-- размерный ряд и количество -->
                    <TextBlock Text="Выберите размер:" Margin="0,10,0,0"/>
                    <ComboBox ItemsSource="{Binding AvailableSizes}"
                              SelectedItem="{Binding SelectedSize}"
                              HorizontalAlignment="Left"
                              MinWidth="200">
                        <ComboBox.ItemTemplate>

                            <DataTemplate x:DataType="models:Size">

                                <TextBlock Text="{Binding Size1}"/>

                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Количество:" Margin="0,10,0,0"/>
                    <TextBox Text="{Binding OrderCount}" Width="150"
                             HorizontalAlignment="Left"/>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
                        <Button Content="Добавить в заказ"
                                Command="{Binding AddToCartCommand}"/>
                        <Button Content="Назад"
                                Command="{Binding BackToProductsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!--  текущий заказ -->
            <Border Grid.Column="1" Background="#F5F5F5" Padding="10">
                <Grid RowDefinitions="Auto, *, Auto">

                    <TextBlock Grid.Row="0" Text="Текущий заказ"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Cart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gray" BorderThickness="1"
                                            Padding="8" Margin="0,0,0,5">
                                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Spacing="5">
                        <Button Content="Оформить заказ"
                                Command="{Binding ConfirmOrderCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        <Button Content="Отменить заказ"
                                Command="{Binding CancelOrderCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</UserControl>
